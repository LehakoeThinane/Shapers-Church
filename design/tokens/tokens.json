        "tileEdge": { "$value": "rgba(255,255,255,0.70)" },
        "danger": { "$value": "#A3372B" },
        "success": { "$value": "#2F6B45" },
        "video": {
          "start": { "$value": "#8E7C76" },
          "middle": { "$value": "#D2979F" },
          "end": { "$value": "#B5A59E" },
          "glow": { "$value": "rgba(235,230,228,0.70)" }
        }
      }
    }
  },
  "font": {
    "ui": { "$value": "-apple-system, \"SF Pro Text\", \"SF Pro Display\", Figtree, system-ui, sans-serif", "$description": "System font on Apple devices, Figtree elsewhere." },
    "uiNative": { "$value": "Figtree", "$description": "Android and web fallback family name." },
    "serif": { "$value": "Newsreader, Georgia, serif", "$description": "Italic accents: scripture, series titles." },
    "serifNative": { "$value": "Newsreader" }
  },
  "radius": {
    "sm": { "$value": 12 },
