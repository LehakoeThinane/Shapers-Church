{
  "$description": "Shapers design tokens. Single source of truth for the member app and the admin portal. Edit here, then run `pnpm tokens`. Values come from the brief and design/shapers-glass.html.",
  "palettes": {
    "midnight": {
      "$description": "Dark look: near-black ground, midnight-blue glow, gold accents.",
      "appearance": "dark",
      "color": {
        "background": { "$value": "#050304" },
        "glow": {
          "primary": { "$value": "rgba(25,25,112,0.95)", "$description": "#191970 midnight blue" },
          "secondary": { "$value": "rgba(8,10,48,0.95)", "$description": "#080A30 deep midnight" },
          "accent": { "$value": "rgba(212,178,111,0.22)" },
          "tertiary": { "$value": "rgba(25,25,112,0.65)" },
          "edge": { "$value": "rgba(70,90,210,0.45)", "$description": "Midnight-blue light around glass edges" }
        },
        "rim": {
          "$description": "Gradient stops for the gold-and-blue rim on glass cards, tab bar and key buttons.",
          "$value": ["rgba(232,200,130,0.95)", "rgba(70,90,210,0.55)", "rgba(25,25,112,0.10)", "rgba(70,90,210,0.50)", "rgba(232,200,130,0.70)"]
        },
        "glass": {
          "fill": { "$value": "rgba(255,255,255,0.05)" },
          "fillActive": { "$value": "rgba(212,178,111,0.16)" },
          "edge": { "$value": "rgba(255,255,255,0.06)" },
          "highlight": { "$value": "rgba(255,236,200,0.28)" },
          "sheen": { "$value": "rgba(255,255,255,0.10)" },
          "shadow": { "$value": "rgba(0,0,0,0.55)" }
        },
        "text": {
          "primary": { "$value": "#F3EEE6" },
          "secondary": { "$value": "rgba(243,238,230,0.74)" },
          "tertiary": { "$value": "rgba(243,238,230,0.52)" },
          "onAccent": { "$value": "#0B0F2E" },
          "onButton": { "$value": "#0B0F2E" }
        },
        "accent": { "$value": "#D4B26F", "$description": "Live badge, Give, progress" },
        "interactive": { "$value": "#E0C07F", "$description": "Links, icons, active tab" },
        "button": {
          "primaryTop": { "$value": "#E6C98C" },
          "primaryBottom": { "$value": "#C9A35C" }
