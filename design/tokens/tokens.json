          "middle": { "$value": "#191970" },
          "end": { "$value": "#0A0E2E" },
          "glow": { "$value": "rgba(212,178,111,0.45)" }
        }
      }
    },
    "rose": {
      "$description": "Light look: off-white ground, rose and taupe glow, deep-taupe buttons.",
      "appearance": "light",
      "color": {
        "background": { "$value": "#EBE6E4" },
        "glow": {
          "primary": { "$value": "rgba(210,151,159,0.85)", "$description": "#D2979F rose" },
          "secondary": { "$value": "rgba(181,165,158,0.90)", "$description": "#B5A59E taupe" },
