    "lg": { "$value": 20 },
    "xl": { "$value": 24 },
    "card": { "$value": 30 },
    "pill": { "$value": 999 }
  },
  "space": {
    "xxs": { "$value": 4 },
    "xs": { "$value": 6 },
    "sm": { "$value": 10 },
    "md": { "$value": 14 },
    "lg": { "$value": 18 },
    "xl": { "$value": 22 },
    "xxl": { "$value": 32 }
  },
  "blur": {
    "glass": { "$value": 26 }
