{
  "name": "shapers",
  "private": true,
  "packageManager": "pnpm@10.6.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tokens": "pnpm --filter @shapers/tokens build",
    "api:generate": "pnpm --filter @shapers/api-client generate",
    "check:colours": "node scripts/check-colours.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint && pnpm check:colours",
    "test": "pnpm -r test",
    "admin": "pnpm --filter @shapers/admin dev",
    "mobile": "pnpm --filter @shapers/mobile start",
    "mobile:go": "pnpm --filter @shapers/mobile start:go"
  },
  "pnpm": {
    "overrides": {
      "source-map-js": "^1.2.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-ch52-4w7c-c8xp",
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
