---
import '@shapers/tokens/tokens.css';
import '../styles/site.css';
import Logo from '../components/Logo.astro';
import { get, type Schemas } from '../lib/api';
import { church, telHref, whatsappHref } from '../lib/church';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  /** Private pages (e.g. someone's tickets) stay out of search engines. */
  noindex?: boolean;
  /** The page's language (ISO 639-1, e.g. "zu"); English by default. */
  lang?: string;
  /** The same page in other languages, for search engines. */
  alternates?: { lang: string; href: string }[];
}

const { title, description, image, noindex, lang = 'en', alternates = [] } = Astro.props;
const menu = await get<Schemas['MenuItemDto'][]>('/api/content/menu', []);
const fullTitle = title ? `${title} · Shapers Church` : 'Shapers Church · Rivonia, Johannesburg';
const summary = description ?? 'Shapers Church in Rivonia, Johannesburg: building productive people for the kingdom of God.';
const path = Astro.url.pathname;
const nav = [
  { href: '/about', label: 'About' },
  { href: '/growth-track', label: 'Growth Track' },
  { href: '/sermons', label: 'Sermons' },
  { href: '/events', label: 'Events' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];
const current = (href: string) => (path === href || path.startsWith(`${href}/`) ? 'page' : undefined);
const shareImage = new URL(image ?? '/images/og-shapers.jpg', Astro.site);
---

<!doctype html>
<html lang={`${lang}-ZA`} data-palette="midnight">
  <head>
    <meta charset="utf-8" />
    {alternates.map((a) => <link rel="alternate" hreflang={`${a.lang}-ZA`} href={new URL(a.href, Astro.site)} />)}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050304" />
    <title>{fullTitle}</title>
    <meta name="description" content={summary} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={title ?? 'Shapers Church'} />
    <meta property="og:description" content={summary} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={shareImage} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Shapers Church sermons" href="/podcast.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Jost:wght@300;400&family=Newsreader:ital,opsz@1,6..72&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header" id="site-header">
      <div class="wrap site-header-inner">
        <a class="brand" href="/" aria-label="Shapers Church home"><Logo /></a>
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav">
          <span class="menu-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Menu</span>
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={current(item.href)}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="site-nav-actions">
            <a class="button ghost small" href="/live"><span class="live-dot" aria-hidden="true"></span>Watch live</a>
            <a class="button small" href="/give">Give</a>
          </div>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer band band-dark">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <Logo layout="stacked" />
          <p>{church.tagline}.</p>
        </div>
        <div>
          <h2>Visit</h2>
          <p>{church.sunday.day} at {church.sunday.time}<br />{church.address}</p>
          <p><a href={church.mapsUrl} rel="noopener" target="_blank">Get directions</a></p>
          <p>{church.midweek.day} at {church.midweek.time} {church.midweek.where}</p>
        </div>
        <div>
          <h2>Contact</h2>
          <p><a href={`mailto:${church.email}`}>{church.email}</a></p>
          {church.phones.map((phone) => <p><a href={telHref(phone)}>{phone}</a></p>)}
          {
            church.whatsapp && (
              <p>
                <a href={whatsappHref(church.whatsapp)} rel="noopener" target="_blank">Chat with us on WhatsApp</a>
              </p>
            )
          }
          <ul class="social">
            {church.social
              .filter((s) => s.href)
              .map((s) => (
                <li>
                  <a href={s.href!} rel="noopener" target="_blank">{s.label}</a>
                </li>
              ))}
          </ul>
        </div>
        <div>
          <h2>Explore</h2>
          <ul class="footer-links">
            <li><a href="/sermons">Sermons</a></li>
            <li><a href="/live">Watch live</a></li>
            <li><a href="/events">Events</a></li>
            <li><a href="/whats-on">What&apos;s on</a></li>
            <li><a href="/give">Give</a></li>
            <li><a href="/connect">I&apos;m new</a></li>
            {menu.map((m) => <li><a href={`/${m.slug}`}>{m.title}</a></li>)}
          </ul>
        </div>
      </div>
      <div class="wrap footer-legal">
        <span>© {new Date().getFullYear()} Shapers Church</span>
        <span><a href="/privacy">Privacy notice</a> · <a href="/podcast.xml">Sermon podcast</a></span>
      </div>
    </footer>
  </body>
</html>

<script>
  // Small screens: the menu opens from the button.
  const header = document.getElementById('site-header')!;
  const button = header.querySelector<HTMLButtonElement>('.menu-button')!;
  button.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', String(open));
    header.classList.toggle('open', open);
  });

  // Scroll reveal: sections and cards below the fold fade up as they come into view, rows of cards one after
  // another. Anything already on screen is left alone, and nothing moves for people who prefer reduced motion.
  const targets = [
    '.band .section-head',
    '.band .split > *',
    '.band .feature',
    '.cta .wrap > *',
    '.grid > *',
    '.steps > li',
    '.posters > *',
    '.ways > *',
    '.info-grid > *',
    '.beliefs > li',
    '.times-grid > *',
    'main > .section > *',
  ].join(', ');

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          observer.unobserve(el);
          el.classList.add('revealed');
          // Hand the element back to its own hover transitions once it has arrived.
          setTimeout(() => {
            el.classList.remove('reveal', 'revealed');
            el.style.removeProperty('--reveal-delay');
          }, 1400);
        }
      },
      { rootMargin: '0px 0px -8% 0px' },
    );

    for (const el of document.querySelectorAll<HTMLElement>(targets)) {
      if (el.getBoundingClientRect().top < window.innerHeight) continue;
      const siblings = el.parentElement ? [...el.parentElement.children] : [el];
      const index = Math.min(siblings.indexOf(el), 5);
      el.style.setProperty('--reveal-delay', `${index * 90}ms`);
      el.classList.add('reveal');
      observer.observe(el);
    }
  }
</script>
