---
import Base from '../layouts/Base.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import PageHeader from './PageHeader.astro';
import type { Schemas } from '../lib/api';
import { renderMarkdown } from '../lib/format';

interface Props {
  page: Schemas['PageDto'];
}

const { page } = Astro.props;
const basePath = `/${page.slug}`;
const alternates = page.languages.map((l) => ({ lang: l.code, href: l.code === 'en' ? basePath : `${basePath}/${l.code}` }));
---

<Base title={page.title} description={page.summary ?? undefined} lang={page.language} alternates={alternates}>
  <PageHeader title={page.title} intro={page.summary ?? undefined} />
  <section class="band band-paper">
    <article class="wrap prose-wrap" lang={page.language}>
      <LanguageSwitch languages={page.languages} current={page.language} basePath={basePath} />
      <div class="prose article" set:html={renderMarkdown(page.body)} />
    </article>
  </section>
</Base>
