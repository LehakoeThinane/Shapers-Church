---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { get, type Schemas } from '../lib/api';
import { longDate, renderMarkdown } from '../lib/format';

const notice = await get<Schemas['PrivacyNoticeDto'] | null>('/api/privacy/notice', null);
---

<Base title="Privacy notice" description="How Shapers Church looks after your personal information.">
  <PageHeader
    eyebrow="Privacy notice"
    title="How we look after"
    accent="your information."
    intro={notice ? `Version ${notice.version}, in effect from ${longDate(notice.effectiveFrom)}.` : undefined}
  />
  <section class="band band-paper">
    <article class="wrap prose-wrap">
      {
        notice ? (
          <div class="prose article" set:html={renderMarkdown(notice.markdown)} />
        ) : (
          <p>Our privacy notice is being updated. Email info@shaperschurch.com for a copy.</p>
        )
      }
      <div class="prose article" id="cookies">
        <h2>Cookies on this website</h2>
        <p>
          This website doesn't use tracking, analytics or advertising cookies, and doesn't share anything about your visit with other companies.
        </p>
        <p>
          It remembers one thing in your browser: that you've closed the cookie note, so it doesn't show again. Forms you fill in (registering
          for an event, a connect card, giving) send what you type to the church only, as the privacy notice above describes. Card payments happen
          on Yoco's own secure page, under Yoco's privacy terms.
        </p>
        <p>If this ever changes, we'll ask you before anything is turned on.</p>
      </div>
    </article>
  </section>
</Base>
