---
import CmsPage from '../components/CmsPage.astro';
import { get, type Schemas } from '../lib/api';
import { reservedSlugs } from '../lib/church';

// Pages written in the admin portal: About us, Shapers Growth Track, Contact us, Giving, ...
export async function getStaticPaths() {
  const pages = await get<Schemas['PageDto'][]>('/api/content/pages', []);
  return pages.filter((p) => !reservedSlugs.has(p.slug)).map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}

const { page } = Astro.props as { page: Schemas['PageDto'] };
---

<CmsPage page={page} />
