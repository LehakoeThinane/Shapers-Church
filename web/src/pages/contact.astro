---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { church, telHref } from '../lib/church';
---

<Base title="Contact us" description="Visit Shapers Church at 8 Mellis Road, Rivonia, on Sundays, or get in touch by phone or email.">
  <PageHeader
    eyebrow="Contact us"
    title="We'd love to"
    accent="hear from you."
    intro="Visit us on a Sunday, join us online midweek, or get in touch. Someone from the church will get back to you."
  >
    <div class="row" style="margin-top: 2rem">
      <a class="button" href="/connect">Send us a message</a>
      <a class="button ghost" href={`mailto:${church.email}`}>{church.email}</a>
    </div>
  </PageHeader>

  <section class="band band-raised" id="visit">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">Plan your visit</span>
          <h2>Join us <span class="serif">this Sunday.</span></h2>
          <p class="lead">
            Services start at {church.sunday.time}. Arrive a few minutes early: we'd love to welcome you.
          </p>
        </div>
      </div>
      <div class="info-grid">
        <div>
          <span class="label">Sunday service</span>
          <h3>{church.sunday.day} at {church.sunday.time}</h3>
          <p class="muted">{church.address}</p>
          <p><a href={church.mapsUrl} rel="noopener" target="_blank">Get directions ↗</a></p>
        </div>
        <div>
          <span class="label">Midweek</span>
          <h3>{church.midweek.day} at {church.midweek.time}</h3>
          <p class="muted">Midweek meeting on Zoom</p>
          <p class="muted">Meeting ID {church.midweek.zoomId}</p>
        </div>
        <div>
          <span class="label">Call us</span>
          <h3>Phone</h3>
          {church.phones.map((p) => <p><a href={telHref(p)}>{p}</a></p>)}
        </div>
        <div>
          <span class="label">Write to us</span>
          <h3>Email</h3>
          <p><a href={`mailto:${church.email}`}>{church.email}</a></p>
          <p><a href="/connect">Or use our contact form →</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band-paper cta">
    <div class="wrap">
      <span class="eyebrow">First time?</span>
      <h2>Let us know <span class="serif">you're coming.</span></h2>
      <p class="lead">Tell us a little about yourself and we'll look out for you on Sunday.</p>
      <div class="row">
        <a class="button dark" href="/connect">I'm new</a>
        <a class="button secondary" href="/live">Watch online first</a>
      </div>
    </div>
  </section>
</Base>
