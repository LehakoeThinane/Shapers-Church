---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import Share from '../../components/Share.astro';
import { get, getAll, type Schemas } from '../../lib/api';
import { longDate, renderMarkdown } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getAll<Schemas['PostSummaryDto']>('/api/content/posts');
  return posts.map((p) => ({ params: { slug: p.slug }, props: { all: posts } }));
}

const { slug } = Astro.params;
const { all } = Astro.props as { all: Schemas['PostSummaryDto'][] };
const post = await get<Schemas['PostDto'] | null>(`/api/content/posts/${slug}`, null);
if (!post) return Astro.redirect('/blog');
const p = post.post;
// About 220 words a minute.
const readMinutes = Math.max(1, Math.round(post.body.split(/\s+/).length / 220));
const more = all.filter((x) => x.slug !== slug).slice(0, 3);
---

<Base title={p.title} description={p.summary ?? undefined} image={p.coverImageUrl}>
  <section class="band band-dark band-glow detail-hero">
    <div class="wrap prose-wrap">
      <a class="back-link" href="/blog">Blog</a>
      <span class="eyebrow">{p.kind === 'News' ? 'News' : 'Shapers blog'}</span>
      <h1>{p.title}</h1>
      <p class="detail-meta">
        {p.author && <span>{p.author}</span>}
        <span>{longDate(p.publishedAt)}</span>
        <span>{readMinutes} min read</span>
      </p>
    </div>
    {p.coverImageUrl && <img class="detail-cover wrap" src={p.coverImageUrl} alt="" />}
  </section>

  <section class="band band-paper">
    <article class="wrap prose-wrap">
      <div class="prose article" set:html={renderMarkdown(post.body)} />
      <div class="article-end">
        <Share title={p.title} path={`/blog/${p.slug}`} />
      </div>
    </article>
  </section>

  {
    more.length > 0 && (
      <section class="band band-raised">
        <div class="wrap">
          <div class="section-head">
            <h2>More from the blog</h2>
            <a class="arrow-link" href="/blog">All posts</a>
          </div>
          <div class="grid three">
            {more.map((m) => (
              <a class="card" href={`/blog/${m.slug}`}>
                <Cover src={m.coverImageUrl} title={m.title} kicker="Blog" />
                <span class="label">{longDate(m.publishedAt)}</span>
                <strong>{m.title}</strong>
                {m.summary && <span class="muted">{m.summary}</span>}
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
