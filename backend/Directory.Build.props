<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Analyzer rules that fight the chosen style: sealed records, async suffixes, and ConfigureAwait in an ASP.NET app. -->
    <NoWarn>$(NoWarn);CA1848;CA1716;CA1711;CA1707;CA2007;CA1724;CA1305;CA1062;CA1812;CA1515;CA1034;CA1000;CA2227;CA1002;CA1819;CA1056;CA1054;CA1055;CA1308;CA1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Shapers.SharedKernel" />
  </ItemGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CA1861;CA2201;CA1063;CA1816;CA1822;xUnit1051;CA2000;CA2234</NoWarn>
  </PropertyGroup>
</Project>
