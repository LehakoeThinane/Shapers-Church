<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <UserSecretsId>shapers-api-dev</UserSecretsId>
    <!-- Emit the OpenAPI document at build time so the TypeScript client can be generated from it. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../../../packages/api-client</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Modules/Identity/Shapers.Identity.Api/Shapers.Identity.Api.csproj" />
    <ProjectReference Include="../../Modules/People/Shapers.People.Api/Shapers.People.Api.csproj" />
    <ProjectReference Include="../../Modules/Church/Shapers.Church.Api/Shapers.Church.Api.csproj" />
    <ProjectReference Include="../../Modules/Media/Shapers.Media.Api/Shapers.Media.Api.csproj" />
    <ProjectReference Include="../../Modules/Events/Shapers.Events.Api/Shapers.Events.Api.csproj" />
    <ProjectReference Include="../../Modules/Prayer/Shapers.Prayer.Api/Shapers.Prayer.Api.csproj" />
    <ProjectReference Include="../../Modules/Kids/Shapers.Kids.Api/Shapers.Kids.Api.csproj" />
    <ProjectReference Include="../../Modules/Giving/Shapers.Giving.Api/Shapers.Giving.Api.csproj" />
    <ProjectReference Include="../../Modules/Groups/Shapers.Groups.Api/Shapers.Groups.Api.csproj" />
    <ProjectReference Include="../../Modules/Assist/Shapers.Assist.Api/Shapers.Assist.Api.csproj" />
    <ProjectReference Include="../../Modules/Services/Shapers.Services.Api/Shapers.Services.Api.csproj" />
    <ProjectReference Include="../../Modules/Content/Shapers.Content.Api/Shapers.Content.Api.csproj" />
    <ProjectReference Include="../../Modules/Privacy/Shapers.Privacy.Api/Shapers.Privacy.Api.csproj" />
    <ProjectReference Include="../../Modules/Communications/Shapers.Communications.Api/Shapers.Communications.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Shapers.IntegrationTests" />
  </ItemGroup>
</Project>
